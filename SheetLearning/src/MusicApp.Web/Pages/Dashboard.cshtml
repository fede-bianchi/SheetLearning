@page
@model DashboardModel
@{
    ViewData["Title"] = "Dashboard - SheetLearning";
}

<!-- Header -->
<header class="mb-10 flex justify-between items-end">
  <div>
    <h2 class="font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg text-on-surface mb-2">Bentornato, Marco!</h2>
    <p class="font-body-lg text-body-lg text-on-surface-variant">Pronto per la tua sessione musicale di oggi?</p>
  </div>
  <div class="hidden md:flex items-center gap-4">
    <button class="w-10 h-10 rounded-full border border-outline-variant flex items-center justify-center text-on-surface hover:border-primary hover:text-primary transition-colors bg-surface-container-lowest">
      <span class="material-symbols-outlined">notifications</span>
    </button>
    <div class="w-12 h-12 rounded-full bg-surface-variant overflow-hidden border border-outline-variant">
      <div class="w-full h-full flex items-center justify-center text-on-surface-variant font-label-md">M</div>
    </div>
  </div>
</header>

<!-- KPI Row -->
<section class="grid grid-cols-1 md:grid-cols-3 gap-gutter mb-8">
  <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-6 hover:shadow-[0px_4px_6px_rgba(27,31,59,0.04),0px_10px_15px_rgba(27,31,59,0.08)] transition-shadow">
    <div class="flex items-center gap-4 mb-4">
      <div class="w-10 h-10 rounded-lg bg-primary-container/10 flex items-center justify-center text-primary-container">
        <span class="material-symbols-outlined">trending_up</span>
      </div>
      <h3 class="font-label-md text-label-md text-on-surface-variant uppercase">Progressione Settimanale</h3>
    </div>
    <div class="flex items-end gap-2">
      <span class="font-headline-md text-headline-md text-on-surface">+15%</span>
      <span class="font-body-md text-body-md text-outline mb-1">vs last week</span>
    </div>
  </div>
  <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-6 hover:shadow-[0px_4px_6px_rgba(27,31,59,0.04),0px_10px_15px_rgba(27,31,59,0.08)] transition-shadow">
    <div class="flex items-center gap-4 mb-4">
      <div class="w-10 h-10 rounded-lg bg-secondary-container/20 flex items-center justify-center text-secondary">
        <span class="material-symbols-outlined">military_tech</span>
      </div>
      <h3 class="font-label-md text-label-md text-on-surface-variant uppercase">Best Score</h3>
    </div>
    <div class="flex items-end gap-2">
      <span class="font-headline-md text-headline-md text-on-surface">98/100</span>
      <span class="font-body-md text-body-md text-outline mb-1">Solfeggio L3</span>
    </div>
  </div>
  <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-6 hover:shadow-[0px_4px_6px_rgba(27,31,59,0.04),0px_10px_15px_rgba(27,31,59,0.08)] transition-shadow">
    <div class="flex items-center gap-4 mb-4">
      <div class="w-10 h-10 rounded-lg bg-surface-variant flex items-center justify-center text-on-surface-variant">
        <span class="material-symbols-outlined">calendar_today</span>
      </div>
      <h3 class="font-label-md text-label-md text-on-surface-variant uppercase">Lezioni Prenotate</h3>
    </div>
    <div class="flex items-end gap-2">
      <span class="font-headline-md text-headline-md text-on-surface">2</span>
      <span class="font-body-md text-body-md text-outline mb-1">this week</span>
    </div>
  </div>
</section>

<!-- Bento Grid Layout for Main Content -->
<section class="grid grid-cols-1 lg:grid-cols-3 gap-gutter">
  <!-- Next Exercise (Spans 2 columns) -->
  <div class="lg:col-span-2 bg-primary-container text-on-primary-container rounded-xl p-8 relative overflow-hidden group">
    <div class="absolute -right-20 -top-20 w-64 h-64 bg-white/10 rounded-full blur-3xl group-hover:bg-white/20 transition-all duration-500"></div>
    <div class="relative z-10">
      <div class="inline-block px-3 py-1 rounded-full bg-white/20 font-label-md text-label-md text-white mb-6">Consigliato per te</div>
      <h3 class="font-display-lg-mobile md:font-display-lg text-display-lg-mobile md:text-display-lg text-on-primary mb-4">Suggerimento: Lettura Note</h3>
      <p class="font-body-lg text-body-lg text-primary-fixed mb-8 max-w-md">Livello 4 - Affina la tua lettura a prima vista con spartiti di media difficolt&agrave;. Concentrati sul ritmo.</p>
      <a href="/exercises/note-reading" class="inline-flex bg-white text-primary-container px-8 py-3 rounded-lg font-label-md text-label-md hover:bg-surface-container-lowest transition-colors items-center gap-2 shadow-sm">
        <span class="material-symbols-outlined">play_arrow</span>
        Avvia Esercizio
      </a>
    </div>
  </div>

  <!-- Quick Stats (1 column) -->
  <div class="bg-surface-container-lowest border border-outline-variant rounded-xl p-6 flex flex-col">
    <h3 class="font-headline-sm text-headline-sm text-on-surface mb-6">Statistiche Rapide</h3>
    <div class="flex-1 flex flex-col justify-center relative">
      <div class="w-full h-40 flex items-end justify-between gap-2 border-b border-outline-variant/30 pb-2">
        <div class="w-full bg-primary-container/20 rounded-t-sm h-[40%] hover:bg-primary-container/40 transition-colors"></div>
        <div class="w-full bg-primary-container/40 rounded-t-sm h-[60%] hover:bg-primary-container/60 transition-colors"></div>
        <div class="w-full bg-primary-container/60 rounded-t-sm h-[30%] hover:bg-primary-container/80 transition-colors"></div>
        <div class="w-full bg-primary-container/80 rounded-t-sm h-[80%] hover:bg-primary-container transition-colors"></div>
        <div class="w-full bg-primary-container rounded-t-sm h-[100%] shadow-[0_0_8px_rgba(108,92,231,0.4)]"></div>
      </div>
      <div class="flex justify-between mt-2 font-label-md text-label-md text-outline">
        <span>L</span><span>M</span><span>M</span><span>G</span><span>V</span>
      </div>
    </div>
  </div>

  <!-- Recent Activity (Full width below) -->
  <div class="lg:col-span-3 bg-surface-container-lowest border border-outline-variant rounded-xl p-6">
    <div class="flex justify-between items-center mb-6">
      <h3 class="font-headline-sm text-headline-sm text-on-surface">Attivit&agrave; Recente</h3>
      <a class="font-label-md text-label-md text-primary hover:text-primary-container transition-colors" href="#">Vedi tutto</a>
    </div>
    <ul class="space-y-4">
      <li class="flex items-center justify-between p-4 rounded-lg hover:bg-surface-container-low transition-colors border border-transparent hover:border-outline-variant">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-lg bg-surface-variant flex items-center justify-center text-on-surface-variant">
            <span class="material-symbols-outlined">piano</span>
          </div>
          <div>
            <h4 class="font-body-lg text-body-lg text-on-surface font-semibold">Scale Maggiori</h4>
            <p class="font-body-md text-body-md text-on-surface-variant">Tecnica - Livello 3</p>
          </div>
        </div>
        <div class="text-right">
          <div class="font-headline-sm text-headline-sm text-on-surface">92/100</div>
          <div class="font-label-md text-label-md text-outline">Oggi, 10:30</div>
        </div>
      </li>
      <li class="flex items-center justify-between p-4 rounded-lg hover:bg-surface-container-low transition-colors border border-transparent hover:border-outline-variant">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-lg bg-surface-variant flex items-center justify-center text-on-surface-variant">
            <span class="material-symbols-outlined">hearing</span>
          </div>
          <div>
            <h4 class="font-body-lg text-body-lg text-on-surface font-semibold">Dettato Melodico</h4>
            <p class="font-body-md text-body-md text-on-surface-variant">Ear Training - Livello 2</p>
          </div>
        </div>
        <div class="text-right">
          <div class="font-headline-sm text-headline-sm text-on-surface">85/100</div>
          <div class="font-label-md text-label-md text-outline">Ieri, 15:45</div>
        </div>
      </li>
      <li class="flex items-center justify-between p-4 rounded-lg hover:bg-surface-container-low transition-colors border border-transparent hover:border-outline-variant">
        <div class="flex items-center gap-4">
          <div class="w-12 h-12 rounded-lg bg-surface-variant flex items-center justify-center text-on-surface-variant">
            <span class="material-symbols-outlined">history_edu</span>
          </div>
          <div>
            <h4 class="font-body-lg text-body-lg text-on-surface font-semibold">Teoria Musicale Base</h4>
            <p class="font-body-md text-body-md text-on-surface-variant">Teoria - Livello 1</p>
          </div>
        </div>
        <div class="text-right">
          <div class="font-headline-sm text-headline-sm text-on-surface">100/100</div>
          <div class="font-label-md text-label-md text-outline">2 giorni fa</div>
        </div>
      </li>
    </ul>
  </div>
</section>
