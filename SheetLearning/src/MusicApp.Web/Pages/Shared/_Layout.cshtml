<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] - SheetLearning</title>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@700;800&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
  @await Html.PartialAsync("_TailwindConfigPartial")
</head>
<body class="bg-background text-on-surface font-body-md antialiased flex min-h-screen">
  @await Html.PartialAsync("_SidebarPartial")

  <div class="flex-1 md:ml-[280px] flex flex-col min-h-screen">
    @await Html.PartialAsync("_TopBarPartial")

    <main class="flex-1 p-margin-mobile md:p-margin-desktop overflow-y-auto">
      @RenderBody()
    </main>

    <footer class="bg-surface-container-low border-t border-outline-variant mt-auto">
      <div class="flex flex-col md:flex-row justify-between items-center py-gutter px-margin-desktop opacity-80">
        <div class="mb-4 md:mb-0">
          <span class="font-headline-sm text-headline-sm text-primary mr-2">SheetLearning</span>
          <span class="font-body-md text-body-md text-on-surface-variant">&copy; 2024 SheetLearning Platform. All rights reserved.</span>
        </div>
        <div class="flex gap-6 font-body-md text-body-md text-on-surface-variant">
          <a class="hover:underline hover:text-primary transition-colors" href="#">Terms of Service</a>
          <a class="hover:underline hover:text-primary transition-colors" href="#">Privacy Policy</a>
          <a class="hover:underline hover:text-primary transition-colors" href="#">Contact Support</a>
          <a class="hover:underline hover:text-primary transition-colors" href="#">About Us</a>
        </div>
      </div>
    </footer>
  </div>

  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
