<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"] - SheetLearning</title>
  <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@700;800&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
  @await Html.PartialAsync("_TailwindConfigPartial")
</head>
<body class="bg-background text-on-surface font-body-md min-h-screen flex flex-col">
  <header class="sticky top-0 z-50 w-full h-14 bg-surface border-b border-outline-variant flex items-center">
    <div class="flex justify-between items-center px-margin-mobile md:px-margin-desktop w-full max-w-[1440px] mx-auto">
      <div class="flex items-center gap-8">
        <a class="font-headline-sm text-headline-sm text-on-surface" href="/">SheetLearning</a>
        <nav class="hidden md:flex gap-6">
          <a class="text-on-surface-variant font-body-md text-body-md hover:text-primary transition-colors" href="/forum">Forum</a>
          <a class="text-on-surface-variant font-body-md text-body-md hover:text-primary transition-colors" href="/teachers">Teachers</a>
        </nav>
      </div>
      <div class="flex items-center gap-4">
        <button class="hidden md:block text-on-surface-variant font-body-md text-body-md hover:text-primary transition-colors">Login</button>
        <button class="bg-primary-container text-on-primary-container px-4 py-1.5 rounded-lg font-label-md text-label-md hover:opacity-90 transition-opacity">Register</button>
        <button class="text-on-surface-variant hover:text-primary transition-colors flex items-center justify-center w-8 h-8 rounded-full">
          <span class="material-symbols-outlined">dark_mode</span>
        </button>
      </div>
    </div>
  </header>

  <main class="flex-grow">
    @RenderBody()
  </main>

  <footer class="w-full py-12 px-margin-mobile md:px-margin-desktop max-w-[1440px] mx-auto flex flex-col items-center gap-8 bg-surface-container-low border-t border-outline-variant">
    <div class="font-headline-sm text-headline-sm text-on-surface">SheetLearning</div>
    <nav class="flex flex-wrap justify-center gap-x-8 gap-y-4">
      <a class="text-on-surface-variant font-body-md text-body-md hover:text-primary transition-colors" href="#">Forum</a>
      <a class="text-on-surface-variant font-body-md text-body-md hover:text-primary transition-colors" href="#">Teachers</a>
      <a class="text-on-surface-variant font-body-md text-body-md hover:text-primary transition-colors" href="#">Privacy Policy</a>
      <a class="text-on-surface-variant font-body-md text-body-md hover:text-primary transition-colors" href="#">Terms of Service</a>
      <a class="text-on-surface-variant font-body-md text-body-md hover:text-primary transition-colors" href="#">Newsletter</a>
    </nav>
    <div class="text-on-surface-variant font-body-md text-body-md text-center">
      &copy; 2024 SheetLearning. Precision Minimalism in Music Education.
    </div>
  </footer>

  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
